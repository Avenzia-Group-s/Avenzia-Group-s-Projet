{
  "name": "@avenzia/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "node --import ../../scripts/env.mjs ../../node_modules/prisma/build/index.js generate",
    "migrate": "node --import ../../scripts/env.mjs ../../node_modules/prisma/build/index.js migrate dev",
    "deploy": "node --import ../../scripts/env.mjs ../../node_modules/prisma/build/index.js migrate deploy",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
