# Configuration racine. Copier en .env.local ou lancer scripts\setup.bat.
# .env est aussi lu. .env.local a priorité sur .env.
DATABASE_URL=postgresql://avenzia:CHANGE_ME@localhost:5433/avenzia
API_PORT=3000
API_HOST=127.0.0.1
API_TRUST_PROXY_HOPS=0
API_PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:3000
# Adresse utilisée par l'interface. Pour le staff distant, utiliser une API HTTPS.
VITE_API_URL=http://localhost:3000

# Discord Developer Portal > application > OAuth2 / Bot
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=
ROLE_FOUNDER_ID=
ROLE_COFOUNDER_ID=
ROLE_STAFF_ID=

TWO_FA_ENABLED=true
# Secrets locaux générés par setup.bat
INTERNAL_API_SECRET=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Publication locale. GitHub Actions fournit automatiquement son GITHUB_TOKEN.
GITHUB_TOKEN=
GITHUB_REPO=Avenzia-Group-s/Avenzia-Group-s-Projet
